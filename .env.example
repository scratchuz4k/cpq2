APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_GOOGLE_MAPS_API_KEY=

SAIL_XDEBUG_MODE=debug
SAIL_XDEBUG_CONFIG="client_host=host.docker.internal client_port=9003 remote_handler=dbgp idekey=VSCODE start_with_request=yes discover_client_host=1"

ALPNET_API_TOKEN=
TOMTOM_API_KEY=
ADDRESS_LOOKUP_KEY=
PARTNER_QUOTE_SERVICE_URL=
PARTNER_QUOTE_AS_JOB=
PARTNER_QUOTE_LIVE_DATA=false
ITS_CONNECTION_ITS_ACCESSKEY=
VIRTUAL1_CONNECTION_USERNAME=
VIRTUAL1_CONNECTION_PASSWORD=
GAMMA_CONNECTION_USERNAME=
GAMMA_CONNECTION_PASSWORD=
GAMMA_CONNECTION_CLIENTID=
GIACOM_CONNECTION_USERNAME=
GIACOM_CONNECTION_PASSWORD=
SHOPBLOCKS_API_KEY=
